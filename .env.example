# Copy this file to .env.local and fill in your values
# Never commit .env.local to git

# Your Lightning address (e.g. yourname@getalby.com)
VITE_LIGHTNING_ADDRESS=your@lightning.address

# Your display name on the tip page
VITE_CREATOR_NAME=Your Name

# Your handle (shown under the name)
VITE_CREATOR_HANDLE=@yourhandle

# Short bio shown on the tip page
VITE_CREATOR_BIO=Your bio here
